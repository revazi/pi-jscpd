{
  "name": "pi-jscpd",
  "version": "0.0.0",
  "private": true,
  "description": "A Pi-native, polyglot duplication guardrail powered by jscpd.",
  "type": "module",
  "license": "MIT",
  "author": "Revaz Zakalashvili",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revazi/pi-jscpd.git"
  },
  "homepage": "https://github.com/revazi/pi-jscpd#readme",
  "bugs": {
    "url": "https://github.com/revazi/pi-jscpd/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "jscpd",
    "code-duplication",
    "agentic-coding"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "biome check --write .",
    "lint": "biome check .",
    "check": "npm run typecheck && npm run lint && npm test",
    "pack:dry-run": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
